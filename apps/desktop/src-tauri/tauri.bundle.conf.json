{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run bundle-web -w @deadlock/desktop && npm run build -w @deadlock/desktop"
  },
  "bundle": {
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/web/": "web/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
