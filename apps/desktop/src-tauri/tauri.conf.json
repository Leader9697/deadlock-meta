{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Meta",
  "version": "0.3.26",
  "identifier": "id.faris.deadlockmeta",
  "build": {
    "beforeDevCommand": "npm run dev -w @deadlock/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @deadlock/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Deadlock Meta",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMUFBQzUwNTVFRTYyMTIKUldRU1l1NVZVS3dhdnloTTkyWExWdDlZNVBSSTE2cFlGZmJPRDQyMFpmZVV6aStSRTBxT3JBcmYK",
      "endpoints": [
        "https://github.com/Leader9697/deadlock-meta/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
