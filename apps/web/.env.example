# Optional. deadlock-api works without a key; a key raises analytics rate limit 200 → 400 req/min.
DEADLOCK_API_KEY=
# Optional. Lock /api/* CORS to your desktop app origin, e.g. http://tauri.localhost
API_CORS_ORIGIN=
# Optional. Shared secret for the overlay's private data (/api/me/log, habits, calibration).
# The installed app sets it for its bundled site by itself; without it only `npm run dev` accepts logs.
DLM_INTERNAL_TOKEN=
# Optional. Folder for overlay match logs and the offline copy of deadlock-api data (default apps/web/.data).
DLM_DATA_DIR=
